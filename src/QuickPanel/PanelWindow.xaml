<Window x:Class="QuickPanel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:QuickPanel"
        Title="快捷面板"
        Icon="assets/app.ico"
        Width="720" Height="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        PreviewDragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <DataTemplate x:Key="ResultRowTemplate">
            <Border Height="46" Background="Transparent" Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="7"
                            Background="{DynamicResource SurfaceBrush}"
                            VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="28" Height="28"
                               Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}"
                                   Foreground="{DynamicResource TextDimBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4"
                            Background="{DynamicResource SurfaceBrush}" Padding="6,2">
                        <TextBlock Text="{Binding KindText}"
                                   Foreground="{DynamicResource TextDimBrush}" FontSize="10" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部：搜索框 + 操作按钮（按住空白处可拖动面板） -->
            <Border x:Name="TopBar"
                    Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTopBarMouseDown">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Height="30"
                            Width="440"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="0,0,14,0">
                        <TextBox x:Name="SearchBox"
                                 Style="{DynamicResource SearchBoxStyle}"
                                 Margin="9,0"
                                 TextChanged="OnSearchTextChanged" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="AddButton"
                                Style="{DynamicResource IconButtonStyle}"
                                ToolTip="添加磁贴（文件 / 文件夹 / 网址）"
                                Click="OnAddClick">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Text="&#xE710;" FontSize="14" />
                        </Button>
                        <Button x:Name="EditButton"
                                Style="{DynamicResource IconButtonStyle}"
                                ToolTip="编辑模式：钉住面板，拖入添加、拖拽排序"
                                Click="OnEditClick">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Text="&#xE70F;" FontSize="14" />
                        </Button>
                        <Button x:Name="SettingsButton"
                                Style="{DynamicResource IconButtonStyle}"
                                ToolTip="设置（主题 / 热键 / 开机自启 / 数据目录）"
                                Click="OnSettingsClick">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Text="&#xE713;" FontSize="14" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{DynamicResource IconButtonStyle}"
                                ToolTip="关闭面板 (Esc)"
                                Click="OnCloseClick">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Text="&#xE711;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区：磁贴网格（无输入时） / 搜索结果列表（输入时） -->
            <Grid Grid.Row="1" Background="Transparent">
                <ScrollViewer x:Name="TileViewHost"
                              Margin="8"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Left"
                              VerticalContentAlignment="Top">
                    <local:TilePanel x:Name="TileGrid" VerticalAlignment="Top" />
                </ScrollViewer>

                <ListBox x:Name="ResultList"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="4,6"
                         ItemTemplate="{StaticResource ResultRowTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonUp="OnResultRightClick"
                         PreviewMouseLeftButtonUp="OnResultClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="2,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock x:Name="EmptyHint"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
                <TextBlock x:Name="EditHint"
                           Text="编辑模式：面板已钉住（点别处不关）· 从资源管理器拖入添加 · 拖拽排序 · 右键改名/换图标/删除 · Esc 或 ✎ 退出"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,8"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>
