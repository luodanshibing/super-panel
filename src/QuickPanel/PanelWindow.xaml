<Window x:Class="QuickPanel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷面板"
        Width="720" Height="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="{DynamicResource BgBrush}"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部搜索框（P2 接入真实搜索） -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="搜索应用、文件、文件夹（P2 接入）"
                               Foreground="{DynamicResource TextDimBrush}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox"
                             Style="{DynamicResource SearchBoxStyle}"
                             TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <!-- 磁贴网格（P0 为示例数据，P1 接入真实条目） -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                    <UniformGrid x:Name="TileGrid" Columns="8" />
                </ScrollViewer>
                <TextBlock Text="P0 骨架版 · 示例磁贴仅看观感"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,8" />
            </Grid>
        </Grid>
    </Border>
</Window>
