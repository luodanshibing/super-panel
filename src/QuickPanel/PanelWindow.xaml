<Window x:Class="QuickPanel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷面板"
        Width="720" Height="480"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="{DynamicResource BgBrush}"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Deactivated="OnDeactivated"
        PreviewKeyDown="OnPreviewKeyDown">

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部搜索框：P1 先做面板内过滤，P2 接程序索引 + Everything -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <TextBlock x:Name="SearchPlaceholder"
                               Text="过滤面板磁贴（全盘搜索在 P2 接入）"
                               Foreground="{DynamicResource TextDimBrush}"
                               FontSize="15"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />
                    <TextBox x:Name="SearchBox"
                             Style="{DynamicResource SearchBoxStyle}"
                             TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <!-- 磁贴网格 -->
            <Grid Grid.Row="1" Background="Transparent">
                <ScrollViewer Margin="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <UniformGrid x:Name="TileGrid" Columns="8" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint"
                           Text="把程序、文件、文件夹从资源管理器拖进来即可添加"
                           Foreground="{DynamicResource TextDimBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Border>
</Window>
